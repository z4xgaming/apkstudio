<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <TextView
        android:text="🎭 APK Cloner"
        android:textColor="#FFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:gravity="center"
        android:background="#1E1E1E"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnPick"
        android:text="📂 APK Select Karo"
        android:textColor="#FFF"
        android:textSize="15sp"
        android:backgroundTint="#2196F3"
        android:layout_margin="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvInfo"
        android:textColor="#FFF"
        android:textSize="13sp"
        android:padding="16dp"
        android:background="#1A1A1A"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btnClone"
        android:text="🎭 Clone Karo"
        android:textColor="#FFF"
        android:textSize="15sp"
        android:backgroundTint="#9C27B0"
        android:enabled="false"
        android:layout_margin="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button android:id="@+id/btnInstall"
            android:text="⬇️ Install"
            android:textColor="#FFF"
            android:textSize="14sp"
            android:backgroundTint="#4CAF50"
            android:enabled="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button android:id="@+id/btnShare"
            android:text="📤 Share"
            android:textColor="#FFF"
            android:textSize="14sp"
            android:backgroundTint="#FF9800"
            android:enabled="false"
            android:layout_marginStart="6dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/progress"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvStatus"
        android:text="Ready"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        android:padding="12dp"
        android:background="#1A1A1A"
        android:layout_margin="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
